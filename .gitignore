# Git ignore

# OS
.DS_Store
Thumbs.db

# Editor
.idea/
.vscode/
*.swp

# Logs
*.log

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Virtual environments
venv/
venv-*/
*.venv/

# Data (uploaded files, processed results)
data/
!data/.gitkeep

# Models (downloaded model weights)
models/
!models/.gitkeep

# Environment
.env